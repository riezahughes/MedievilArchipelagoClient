<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\MediEvilFont.ttf" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\MediEvilFont.ttf">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Local dev machine: use your local fork checkout if present -->
	<ItemGroup Condition="Exists('D:\Archipelago\dev\Archipelago.core.myrepo\Archipelago.Core\Archipelago.Core.csproj')">
		<ProjectReference Include="D:\Archipelago\dev\Archipelago.core.myrepo\Archipelago.Core\Archipelago.Core.csproj"
						   AdditionalProperties="AllowUnsafeBlocks=true" />
	</ItemGroup>

	<!-- CI / anyone else: use the published NuGet package -->
	<ItemGroup Condition="!Exists('D:\Archipelago\dev\Archipelago.core.myrepo\Archipelago.Core\Archipelago.Core.csproj')">
		<PackageReference Include="Archipelago.Core" Version="2.1.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Kokuban" Version="0.2.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
		<PackageReference Include="NAudio" Version="2.2.1" />
	</ItemGroup>
	<ItemGroup>
		<None Include=".github\workflows\release.yml" />
	</ItemGroup>
</Project>